local function ByteToHex(n)
n = math.clamp(math.floor(n + 0.5), 0, 255)
local hi = math.floor(n / 16) + 1
local lo = (n % 16) + 1
return HexChars:sub(hi, hi) .. HexChars:sub(lo, lo)
end

