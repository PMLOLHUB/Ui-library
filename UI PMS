local function UpdateSize()
local visibleCount = 0
for _, btn in ipairs(OptionBtns) do
if btn.Visible then visibleCount = visibleCount + 1 end
end
local targetHeight = isOpen and (65 + (visibleCount * 30)) or 35
TweenService:Create(DropdownContainer, TweenInfo.new(0.2), {
Size = UDim2.new(0.95, 0, 0, targetHeight),
}):Play()
