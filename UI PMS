local WindowAnimating = false
local function SetWindowOpen(shouldOpen)
if WindowAnimating or shouldOpen == MainFrame.Visible then return end
WindowAnimating = true
local fullSize = MainFrame.Size
local fullPos = MainFrame.Position
local centerPos = UDim2.new(fullPos.X.Scale, fullPos.X.Offset + fullSize.X.Offset / 2, fullPos.Y.Scale, fullPos.Y.Offset + fullSize.Y.Offset / 2)
local zeroSize = UDim2.new(fullSize.X.Scale, 0, fullSize.Y.Scale, 0)

if shouldOpen then
MainFrame.Size = zeroSize
MainFrame.Position = centerPos
MainFrame.Visible = true
local openTween = TweenService:Create(MainFrame, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
Size = fullSize,
Position = fullPos,
})
openTween.Completed:Connect(function() WindowAnimating = false end)
openTween:Play()
else
local closeTween = TweenService:Create(MainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
Size = zeroSize,
Position = centerPos,
})
closeTween.Completed:Connect(function()
MainFrame.Visible = false
MainFrame.Size = fullSize
MainFrame.Position = fullPos
WindowAnimating = false
end)
closeTween:Play()
end
end

