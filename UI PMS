local function SafeSetProperty(instance, property, value)
if not instance then return false end
local ok = pcall(function() instance[property] = value end)
if ok then return true end
if property == 'TextColor3' and instance:IsA('ImageLabel') then
pcall(function() instance.ImageColor3 = value end)
return true
end
if property == 'BackgroundColor3' and instance:IsA('ImageLabel') then
pcall(function() instance.ImageColor3 = value end)
return true
end
return false
end

local function MakeDraggable(DraggableObject, TargetObject, OnDragEnd)
TargetObject = TargetObject or DraggableObject
local dragging, dragInput, dragStart, startPos
DraggableObject.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
dragging = true
dragStart = input.Position
startPos = TargetObject.Position
local connection
connection = input.Changed:Connect(function()
if input.UserInputState == Enum.UserInputState.End then
dragging = false
connection:Disconnect()
if OnDragEnd then OnDragEnd() end
end
end)
end
end)
DraggableObject.InputChanged:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
dragInput = input
end
end)
UserInputService.InputChanged:Connect(function(input)
if input == dragInput and dragging then
local delta = input.Position - dragStart
TargetObject.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
end)
end

-- Hover effect ทั่วไป: สว่างขึ้นเล็กน้อยตอนเมาส์ชี้ที่ instance แล้ว fade กลับสีเดิมตอนเมาส์ออก
-- getBaseColor: ฟังก์ชันคืนค่าสีปัจจุบันที่ "ควรกลับไป" ตอนเมาส์ออก (เผื่อสีถูกเปลี่ยนจาก Settings ระหว่างนั้น)
local function AddHoverBrighten(instance, getBaseColor, brightenAmount)
brightenAmount = brightenAmount or 0.1
instance.MouseEnter:Connect(function()
local ok, base = pcall(getBaseColor)
if not ok or not base then return end
local h, s, v = base:ToHSV()
local hoverColor = Color3.fromHSV(h, s, math.clamp(v + brightenAmount, 0, 1))
TweenService:Create(instance, TweenInfo.new(0.12), { BackgroundColor3 = hoverColor }):Play()
end)
instance.MouseLeave:Connect(function()
local ok, base = pcall(getBaseColor)
if not ok or not base then return end
TweenService:Create(instance, TweenInfo.new(0.16), { BackgroundColor3 = base }):Play()
end)
end

