-- ===================== Font (รูปแบบตัวอักษร / ขนาดตัวอักษร) =====================
-- รายชื่อฟอนต์ที่เลือกได้ — ดึง "ทุกฟอนต์" ที่มีอยู่จริงบน Roblox ในตอนรันสด (Enum.Font:GetEnumItems())
-- แทนที่จะไล่พิมพ์ชื่อฟอนต์ทีละตัว วิธีนี้ครอบคลุมฟอนต์ทั้งหมดเสมอ แม้ Roblox จะเพิ่มฟอนต์ใหม่ในอนาคต
-- แต่ละฟอนต์จะพยายามหาคู่ 'Bold' ของตัวเอง (เช่น Gotham -> GothamBold) ถ้าไม่มีคู่ Bold จะใช้ตัวเองแทน
-- ครอบทั้งบล็อกด้วย pcall: บาง executor อาจไม่รองรับ Enum.Font:GetEnumItems() ครบ 100% ถ้าพังจะไม่ทำให้
-- สคริปต์ทั้งตัวหยุดทำงานกลางคัน (ซึ่งจะทำให้ UI ทั้งหน้าต่างไม่ขึ้นเลย) แต่จะสลับไปใช้ลิสต์ฟอนต์สำรองที่ปลอดภัยแทน
local FontPresets = {}
local FontPresetOrder = {}
local fontBuildOk = pcall(function()
for _, fontEnum in ipairs(Enum.Font:GetEnumItems()) do
local fontName = fontEnum.Name
local boldOk, boldEnum = pcall(function()
return Enum.Font[fontName .. 'Bold']
end)
FontPresets[fontName] = {
Regular = fontEnum,
Bold = (boldOk and boldEnum) or fontEnum,
}
table.insert(FontPresetOrder, fontName)
end
table.sort(FontPresetOrder)
end)
if not fontBuildOk or #FontPresetOrder == 0 then
-- ลิสต์ฟอนต์สำรอง (เดิมที่เคยใช้และรู้อยู่แล้วว่าใช้งานได้แน่นอนทุก executor)
FontPresets = {
Gotham          = { Regular = Enum.Font.Gotham,          Bold = Enum.Font.GothamBold },
GothamBlack     = { Regular = Enum.Font.GothamBlack,     Bold = Enum.Font.GothamBlack },
SourceSans      = { Regular = Enum.Font.SourceSans,      Bold = Enum.Font.SourceSansBold },
SourceSansLight = { Regular = Enum.Font.SourceSansLight, Bold = Enum.Font.SourceSansBold },
}
FontPresetOrder = { 'Gotham', 'GothamBlack', 'SourceSans', 'SourceSansLight' }
end

local CurrentFontFamilyName = 'Gotham'
if Config.FontFamily and FontPresets[Config.FontFamily] then
CurrentFontFamilyName = Config.FontFamily
end

-- ตัวคูณขนาดตัวอักษร (1 = 100% ปกติ) ปรับได้ระหว่าง 0.8 - 1.3
local CurrentFontScale = Config.FontScale or 1

-- ภาษาที่ใช้แสดงผลในเมนู Settings ('en' = English, 'th' = Thai) — ค่าเริ่มต้นคือ English
local CurrentLanguage = 'en'
if Config.Language then
local cfgLang = string.lower(tostring(Config.Language))
if cfgLang == 'th' or cfgLang == 'thai' then
CurrentLanguage = 'th'
else
CurrentLanguage = 'en'
end
end

