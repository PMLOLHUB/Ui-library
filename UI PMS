SaveConfig(MainFrame)
end
if Callback then Callback(option) end
end)
end

local function ClearOptions()
for _, btn in ipairs(OptionBtns) do
if btn then btn:Destroy() end
end
table.clear(OptionBtns)
end

local function RebuildOptions(newOptions)
ClearOptions()
for _, option in ipairs(newOptions or {}) do AddOption(option) end
for _, btn in ipairs(OptionBtns) do btn.Visible = true end
UpdateSize()
end

DropdownBtn.MouseButton1Click:Connect(function()
isOpen = not isOpen; SearchBox.Text = ''
for _, btn in ipairs(OptionBtns) do btn.Visible = true end
UpdateSize()
end)

SearchBox:GetPropertyChangedSignal('Text'):Connect(function()
local query = string.lower(SearchBox.Text or '')
for _, btn in ipairs(OptionBtns) do
local txt = string.lower(tostring(btn:GetAttribute('OptionText') or btn.Text or ''))
btn.Visible = (query == '') or (string.find(txt, query) ~= nil)
end
UpdateSize()
end)

RebuildOptions(Options)
if Default ~= nil then
DropdownBtn.Text = ' ' .. DropdownText .. ' : ' .. tostring(Default)
end

local DropdownAPI = {}
function DropdownAPI:SetValue(newValue)
CurrentValue = newValue
DropdownBtn.Text = ' ' .. DropdownText .. ' : ' .. tostring(newValue)
if Flag then
Flags[Flag].Value = newValue
SaveConfig(MainFrame)
end
if Callback then Callback(newValue) end
end
function DropdownAPI:Refresh(newOptions)
RebuildOptions(newOptions or Options)
if CurrentValue ~= nil then
DropdownBtn.Text = ' ' .. DropdownText .. ' : ' .. tostring(CurrentValue)
else
DropdownBtn.Text = ' ' .. DropdownText .. ' : Select Option'
end
end
function DropdownAPI:SetOptions(newOptions)
Options = newOptions or {}
RebuildOptions(Options)
if CurrentValue ~= nil then
DropdownBtn.Text = ' ' .. DropdownText .. ' : ' .. tostring(CurrentValue)
else
DropdownBtn.Text = ' ' .. DropdownText .. ' : Select Option'
end
end
return DropdownAPI
end

return CategoryElements, CategoryPage, CategoryBtn
end
