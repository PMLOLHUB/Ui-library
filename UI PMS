local Library = {}
local HttpService = game:GetService('HttpService')
local ConfigFileName = 'PMS_Config.json'
local EnableSave = true

-- เก็บค่า element ที่ตั้ง Flag ไว้ (เช่น Dropdown, Toggle) เพื่อเซฟ/โหลดค่าที่เลือก
local Flags = {}

-- เก็บค่าธีม (สี Accent, สี Text, ความโปร่งแสง, Rainbow) เพื่อเซฟ/โหลดจากเมนูตั้งค่า
local ThemeSettings = {}

local function SaveConfig(frame)
if not EnableSave or not frame then
return
end
if not (writefile and readfile and isfile) then
return
end

local camera = workspace.CurrentCamera
local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
local pos = frame.AbsolutePosition
local size = frame.AbsoluteSize
local outOfBounds = false

if pos.X < 0 or pos.Y < 0 or (pos.X + size.X) > viewport.X or (pos.Y + size.Y) > viewport.Y then
outOfBounds = true
end

local data = {
Width = size.X,
Height = size.Y,
}

if outOfBounds then
data.PosX = (viewport.X / 2) - (size.X / 2)
data.PosY = (viewport.Y / 2) - (size.Y / 2)
else
data.PosX = pos.X
data.PosY = pos.Y
end

data.Flags = {}
for flagName, flagData in pairs(Flags) do
data.Flags[flagName] = flagData.Value
end

data.Theme = ThemeSettings

local success, json = pcall(function()
return HttpService:JSONEncode(data)
end)

if success then
pcall(function()
writefile(ConfigFileName, json)
end)
end
end

local function LoadConfig()
if not EnableSave then
return nil, nil
end
if not (writefile and readfile and isfile) then
return nil, nil
end
if not isfile(ConfigFileName) then
return nil, nil
end

local success, content = pcall(readfile, ConfigFileName)

if not success or not content then
return nil, nil
end

local ok, data = pcall(function()
return HttpService:JSONDecode(content)
end)

if ok and data and data.Width and data.Height then
local loadedSize = UDim2.new(0, data.Width, 0, data.Height)
local loadedPos = nil

if data.PosX and data.PosY then
loadedPos = UDim2.new(0, data.PosX, 0, data.PosY)
end

return loadedSize, loadedPos, data.Flags, data.Theme
end

return nil, nil, nil, nil
end


